export type NativePreclaimReconciliation={schema:'native-preclaim-reconciliation-v1';state:'unknown'|'cooldown'|'exhausted'|'resolved'|'superseded';code:string;phase:'automatic-material-selection';fingerprint:string;evidence_hashes:string[];next_retry_at?:string;previous_fingerprint?:string;replacement_policy_id?:'content-motion@1';original_result_unknown?:true};
const hash=(v:unknown)=>typeof v==='string'&&/^[a-f0-9]{64}$/.test(v);
export function validNativePreclaimReconciliation(v:any):v is NativePreclaimReconciliation{
 const codes={unknown:'AUTO_MATERIAL_RESULT_RECONCILIATION_REQUIRED',cooldown:'AUTO_MATERIAL_RATE_LIMITED',exhausted:'AUTO_MATERIAL_RETRY_EXHAUSTED',resolved:'AUTO_MATERIAL_RECONCILED',superseded:'AUTO_MATERIAL_LEGACY_PLAN_SUPERSEDED'};
 return !!v&&v.schema==='native-preclaim-reconciliation-v1'&&Object.keys(codes).includes(v.state)&&v.code===codes[v.state as keyof typeof codes]&&v.phase==='automatic-material-selection'&&hash(v.fingerprint)&&Array.isArray(v.evidence_hashes)&&v.evidence_hashes.length<=512&&v.evidence_hashes.every(hash)&&new Set(v.evidence_hashes).size===v.evidence_hashes.length&&Object.keys(v).every(k=>['schema','state','code','phase','fingerprint','evidence_hashes','next_retry_at','previous_fingerprint','replacement_policy_id','original_result_unknown'].includes(k))&&(v.state==='cooldown'?typeof v.next_retry_at==='string'&&Number.isFinite(Date.parse(v.next_retry_at)):v.next_retry_at===undefined)&&(['resolved','superseded'].includes(v.state)?hash(v.previous_fingerprint)&&v.evidence_hashes.length>0:v.previous_fingerprint===undefined)&&(v.state==='superseded'?v.replacement_policy_id==='content-motion@1'&&v.original_result_unknown===true:v.replacement_policy_id===undefined&&v.original_result_unknown===undefined);
}
export function nativeReconciliationHolds(v:any,now=Date.now()){return validNativePreclaimReconciliation(v)&&!['resolved','superseded'].includes(v.state)&&(v.state!=='cooldown'||Date.parse(v.next_retry_at!)>now);}
// Completed preparation is not completed rework. This hint admits only the
// original readback; the existing claim gate still rejects an unresolved hold.
export function completedSelectionReadbackCandidate(h:any){const b=h?.base_video,r=h?.reconciliation;return h?.binding?.scope==='private-video'&&h.status==='completed'&&h.lease_until==null&&!!b&&Object.keys(b).sort().join(',')==='artifact_hash,artifact_version,id'&&/^local_review_video_[a-f0-9]{64}$/.test(b.id||'')&&hash(b.artifact_hash)&&Number.isSafeInteger(b.artifact_version)&&b.artifact_version>0&&validNativePreclaimReconciliation(r)&&(r.state==='unknown'||r.state==='superseded'&&h.checkpoint?.selection_continuation_pending===true)&&r.evidence_hashes.length>0;}
export function nativeReconciliationDetail(v:NativePreclaimReconciliation){return v.state==='superseded'?'旧选材提案仍为未知并保留；已确认旧进程停止，按本人新批准的内容画面规则另行策划，不重放旧调用。':v.state==='cooldown'?'本次选材请求被限流且未产生结果；按真实回执退避后系统接续，原材料与音轨保留。':v.state==='exhausted'?'选材有限重试已用完，等待系统复核原执行记录；无需重新提交材料，不重复生成音轨。':v.state==='resolved'?'原选材调用已按不可变进程证据核对，保留旧记录，正常队列可继续。':'旧调用待系统核对；已保留原记录、材料与音轨，无需重新提交材料，核对前不重新调用模型。';}
