// Original media length is distinct from the conservative four-second reserve.
export const OUTRO_POLICY_VERSION='outro-v6-20261024';
export type OutroTone='dark'|'light';
export function outroVariant(background:OutroTone|'mixed',ending?:OutroTone):OutroTone{const tone=background==='mixed'?ending:ending||background;if(tone!=='dark'&&tone!=='light')throw Error('Mixed-background production requires the actual ending background tone');return tone==='dark'?'light':'dark';}
export function originalOutroFrames(ref:any,projectFrames?:unknown){const n=ref?.frames??projectFrames??120;if(!Number.isSafeInteger(n)||![119,120].includes(n))throw Error('Pinned original outro must retain its exact119 or legacy120 frames');if((['v5','v6'].includes(ref?.version)||['outro-v5-20261021',OUTRO_POLICY_VERSION].includes(ref?.policy_version))&&n!==119)throw Error('The V5/V6 original has119frames; never pad it to120');return n as number;}
export function originalOutroSeconds(ref:any,projectFrames?:unknown){return originalOutroFrames(ref,projectFrames)/30;}
export function defaultOutroAsset(catalog:any,background:OutroTone|'mixed',ending?:OutroTone){const variant=outroVariant(background,ending),a=catalog?.variants?.[variant],policy=catalog?.version==='v6'?OUTRO_POLICY_VERSION:catalog?.version==='v5'?'outro-v5-20261021':null;if(catalog?.schema!=='owner-outro-assets-v1'||!policy||catalog.policy_version!==policy||!a||!(/^[a-f0-9]{64}$/).test(a.sha256||'')||!Number.isSafeInteger(a.size_bytes)||a.size_bytes<1||a.frames!==119||a.fps!==30||a.width!==1080||a.height!==1920||Math.abs(a.duration_seconds-119/30)>.000001||typeof a.file_name!=='string'||!a.file_name)throw Error('Current owner-approved V5/V6 outro catalog or exact original metadata missing');return{...a,variant,version:catalog.version,policy_version:policy,frames:119,fps:30,playback_rate:1,reserved_budget_seconds:4,terminal_background_tone:background==='mixed'?ending:ending||background};}
