export const VIDEO_TYPES={story:'兴趣故事',skill:'技能介绍',tool:'工具演示',news:'进展介绍',other:'其他'};
export const METRICS={plays:'播放量',three_second_rate:'3秒留存率（%）',average_duration:'平均观看时长（秒）',completion_rate:'完播率（%）',recommendations:'推荐（互动）',recommendation_views:'推荐来源播放（若后台可见）',likes:'赞',comments:'评论',shares:'分享',saves:'收藏',follows:'关注'};
export type Metrics=Record<keyof typeof METRICS,number|null>;
export function metrics(input:unknown):Metrics{if(!input||typeof input!=='object')throw Error('请填写实际采样指标');const out={} as Metrics;for(const key of Object.keys(METRICS) as (keyof Metrics)[]){const value=(input as Record<string,unknown>)[key];if(value===null||value===undefined||value===''){out[key]=null;continue;}if(typeof value!=='number'||!Number.isFinite(value)||value<0||(key.endsWith('rate')&&value>100)||(!key.endsWith('rate')&&key!=='average_duration'&&!Number.isInteger(value)))throw Error(METRICS[key]+'格式无效；未知留空');out[key]=value;}return out;}
export function hoursFrom(published:string,observed:string|null){const hours=observed?(Date.parse(observed)-Date.parse(published))/3600000:null;return hours!==null&&Number.isFinite(hours)?hours:null;}
export function samplingWindow(published:string,observed:string|null,target:number){const hours=hoursFrom(published,observed);return {hours,target,late_hours:hours===null?null:hours-target,comparable:hours!==null&&Math.abs(hours-target)<=2};}
type Video={id:string;topic_type:string;published_at:string|null;supersedes_id?:string|null};type Sample={id:string;video_id:string;relation_id?:string|null;sample_kind:string;observed_at:string|null;metrics:string};
const median=(a:number[])=>{const s=[...a].sort((x,y)=>x-y);return s.length?s.length%2?s[(s.length-1)/2]:(s[s.length/2-1]+s[s.length/2])/2:null;};
export function typeComparison(videos:Video[],samples:Sample[]){const old=new Set(videos.map(v=>v.supersedes_id).filter(Boolean));return Object.entries(VIDEO_TYPES).map(([type,label])=>{const selected=videos.filter(v=>v.topic_type===type&&v.published_at&&!old.has(v.id)).map(v=>({v,s:samples.filter(s=>s.video_id===v.id&&s.sample_kind==='single_t24'&&!s.relation_id&&samplingWindow(v.published_at!,s.observed_at,24).comparable).sort((a,b)=>Math.abs(hoursFrom(v.published_at!,a.observed_at)!-24)-Math.abs(hoursFrom(v.published_at!,b.observed_at)!-24))[0]})).filter(x=>x.s);const summaries=Object.fromEntries(Object.keys(METRICS).map(key=>{const values=selected.map(x=>JSON.parse(x.s.metrics)[key]).filter((x:unknown)=>typeof x==='number') as number[];return [key,{n:values.length,median:median(values),min:values.length?Math.min(...values):null,max:values.length?Math.max(...values):null}]}));return {type,label,n:selected.length,metrics:summaries,window:'发布后22–26小时实际采样；每片选最接近24小时的一次',interpretation:selected.length<5?'样本少，仅描述，不能判定类型胜出':'描述性比较；选题、推荐曝光和发布时间可能混杂，不推断因果或自动评分'};});}
export function relationshipObservation(relation:{new_video_id:string;old_video_id:string;published_anchor:string},samples:Sample[]){const choose=(kind:string)=>samples.filter(s=>s.relation_id===(relation as {id?:string}).id&&s.video_id===relation.old_video_id&&s.sample_kind===kind&&s.observed_at).sort((a,b)=>Math.abs(hoursFrom(relation.published_anchor,a.observed_at)!-(kind==='relation_baseline'?24:48))-Math.abs(hoursFrom(relation.published_anchor,b.observed_at)!-(kind==='relation_baseline'?24:48)))[0];const baseline=choose('relation_baseline'),followup=choose('relation_followup'),a=baseline?JSON.parse(baseline.metrics):{},b=followup?JSON.parse(followup.metrics):{};const eligible=!!baseline&&!!followup&&samplingWindow(relation.published_anchor,baseline.observed_at,24).comparable&&samplingWindow(relation.published_anchor,followup.observed_at,48).comparable&&Date.parse(followup.observed_at!)>Date.parse(baseline.observed_at!);const delta=Object.fromEntries(Object.keys(METRICS).filter(k=>!k.endsWith('rate')&&k!=='average_duration').map(k=>[k,eligible&&typeof a[k]==='number'&&typeof b[k]==='number'?b[k]-a[k]:null]));return {baseline:baseline||null,followup:followup||null,delta,delta_eligible:eligible,delta_unavailable_reason:eligible?null:!baseline||!followup?'missing-sample':'outside-window-or-invalid-chronology',baseline_window:baseline?samplingWindow(relation.published_anchor,baseline.observed_at,24):null,followup_window:followup?samplingWindow(relation.published_anchor,followup.observed_at,48):null,actual_interval_hours:baseline?.observed_at&&followup?.observed_at?(Date.parse(followup.observed_at)-Date.parse(baseline.observed_at))/3600000:null,warning:'差值是推荐新片发布T+24到T+48之间，被推荐旧片累计指标的增量；不是旧片发布后24小时，也不能证明推荐造成增长。'};}
