# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
artifacts/api-server/.runtime
generated-artifacts
.migration-backup
artifacts/api-server/src/imported/production/**/*.png
artifacts/api-server/src/imported/production/**/*.mp4
artifacts/api-server/src/imported/production/**/*.jpg
artifacts/api-server/src/imported/production/**/*.woff2
