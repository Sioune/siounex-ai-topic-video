export const STUDIO_READY_PLAY_MAX_AGE_MS=90000;
export const STUDIO_EFFECT_SCHEMA='studio-preview-current-effect-v1' as const;
export const STUDIO_GENERATION_SCHEMA='studio-preview-generation-v1' as const;
