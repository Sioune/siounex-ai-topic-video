export type StudioCurrentEffect={schema:typeof STUDIO_EFFECT_SCHEMA;binding:StudioPreviewBinding;draft_id:string;previous_generation_id:string;previous_generation_evidence_sha256:string;policy_id:string;observed_at:string;source:{browser_attempt_id:string;browser_evidence_sha256:string;event_stream_sha256:string;lifecycle_sha256:string;implementation_sha256:string;reconciliation_sha256:string};ui_fully_loaded:true;text_match:true;voice_match:true;audio_state:'valid-cache'|'unavailable'|'unknown';provider_audio_retrievable:boolean|null;generation_in_progress:boolean|null;active_call:boolean|null;editor_conflict:boolean|null;preview_ready:boolean|null;unknown_history_reconciled:true;previous_outcome:StudioPreviousOutcome;history_reinterpreted:false;zero_historical_side_effects_proven:false};
