}
export function studioEffectDecision(v:StudioCurrentEffect){if(v.audio_state==='valid-cache'||v.provider_audio_retrievable===true)return'reuse-cache';if(v.generation_in_progress===true||v.active_call===true)return'wait-current';return v.audio_state==='unavailable'&&v.provider_audio_retrievable===false&&v.generation_in_progress===false&&v.active_call===false&&v.editor_conflict===false&&v.preview_ready===true?'generation-eligible':'reconcile-required';}
export type StudioPreviewGeneration={schema:typeof STUDIO_GENERATION_SCHEMA;generation_id:string;ordinal:number;job_id:string;request_id:string;binding:StudioPreviewBinding;draft_id:string;policy_id:string;policy_sha256:string;previous_generation_id:string;previous_generation_evidence_sha256:string;effect_proof_sha256:string;created_at:string;maximum_play_count:0|1;cache_adoption?:{observed_at:string;browser_evidence_sha256:string};previous_outcome:StudioPreviousOutcome;history_reinterpreted:false;zero_historical_side_effects_proven:false;new_payment_limit:0;new_voice_allowed:false;api_fallback_allowed:false;publication_authorized:false};
