type Job={revision:number;approved_hash:string|null;mode_epoch?:number;contract_hash?:string;reviews?:Record<string,unknown>[]};
export function preparationExecution(j:Job){for(const r of j.reviews||[]){if(r.decision!=='preparation_execution_v1'||r.revision!==j.revision||r.content_hash!==j.approved_hash)continue;try{const v=JSON.parse(String(r.note)),m=v.manifest,b=v.binding;if(v.schema!=='preparation-execution-record-v1'||b.revision!==j.revision||b.script_hash!==j.approved_hash||b.mode_epoch!==j.mode_epoch||b.contract_hash!==j.contract_hash||m.ready!==false||m.native_composition_started!==false||m.quality_approved!==false||m.publication_authorized!==false)continue;return{id:String(r.id),prepared_at:String(m.prepared_at),manifest_sha256:String(v.manifest_sha256),body_seconds:Number(m.body_seconds),planned_total_seconds:Number(m.planned_total_seconds),segment_count:Number(m.segments.length),source_clip_count:Number(m.source_clips.length),ordinary_reference_voice:true,audio_listened:false,native_composition_started:false,missing:m.missing as string[],quality_approved:false,publication_authorized:false};}catch{}}return null;}
