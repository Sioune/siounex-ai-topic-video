function feedbackMarkdown(data:DataInsights){
 const lines=['# '+data.feedback.title,'','资料截至（北京时间）：'+humanTime(data.data_as_of,true),'覆盖指纹：'+data.source_signature,'',...data.feedback.summary.map(s=>'- '+s),'','## 每片表现与下一步',''];
 const show=(key:InsightMetric,n:number|null)=>n===null?'未采集':format(n)+(key.endsWith('rate')?'%':key==='average_duration'?'秒':'');
 for(const v of data.videos){lines.push('### '+v.title,'');const p=v.latest_panel;if(p){
   lines.push(`最新面板（北京时间）：${humanTime(p.observed_at,true)}；用途：${p.sample_kind}；样本：${p.sample_id}。`,'',`播放 ${show('plays',p.metrics.plays)}；3秒留存率 ${show('three_second_rate',p.metrics.three_second_rate)}；完播率 ${show('completion_rate',p.metrics.completion_rate)}；平均观看 ${show('average_duration',p.metrics.average_duration)}。`,'');
   if(p.platform_percentiles.length)lines.push('截图所载平台同类百分位：'+p.platform_percentiles.map(peer=>`${METRICS[peer.metric]} ${format(peer.value)}${peer.label?'（原记录标注“'+peer.label+'”）':''}`).join('；')+'。','');
   if(p.platform_advice)lines.push('原记录中的平台建议：'+p.platform_advice,'');
   lines.push(`来源：${p.source?`${p.source.file_name} / ${p.source.library_file_id} / SHA256 ${p.source.sha256}`:p.evidence_ids.join('、')||'原图关联待补'}。`,'');
   for(const s of v.series){const c=s.latest_pair;if(!c)continue;if(c.delta_eligible){const changes=keys.filter(k=>c.metrics[k].delta!==null).map(k=>{const m=c.metrics[k],suffix=m.unit==='percentage_points'?'个百分点':m.unit==='seconds'?'秒':'';return `${METRICS[k]} ${m.delta!>0?'+':''}${format(m.delta)}${suffix}${m.relative_pct!==null?'（相对变化'+format(m.relative_pct)+'%）':''}`;});lines.push(`同口径观察 ${humanTime(c.baseline.observed_at)} → ${humanTime(c.followup.observed_at)}（北京时间，${format(c.interval_hours)}小时）：${changes.join('；')}。依据样本：${c.baseline.sample_id}、${c.followup.sample_id}。`,'');}else lines.push('本组采样时间不明确或重复，暂不计算变化。','');}
  }else lines.push('尚无已登记效果采样，不能推定表现。','');
   for(const f of [...v.positives,...v.problems,...v.next_steps])lines.push(`- **${f.title}**：${f.text}${f.sample_ids.length?' 依据样本：'+f.sample_ids.join('、')+'。':''}`);
   for(const q of v.quality)lines.push('- 口径提醒：'+q.message+(q.sample_ids.length?'（'+q.sample_ids.join('、')+'）':''));
   lines.push('');
 }
 lines.push('## 推荐关系的独立观察','');for(const r of data.recommendation_observations)lines.push(`- ${r.id}：${r.delta_eligible?'旧片同期播放增量 '+format(r.delta.plays??null):'缺少合格对照窗口，暂不计算增量'}。${r.warning}`);
 lines.push('','## 历史分析的覆盖','');for(const r of data.historical_reports)lines.push(`- ${r.title}（北京时间保存于${humanTime(r.created_at,true)}）：覆盖 ${r.covered_video_ids.length} 片、${r.covered_sample_ids.length} 条当前有效采样，资料截至${humanTime(r.data_as_of,true)}；${r.coverage_current?'关联覆盖与当前一致，仍是历史文本':'未覆盖当前全部资料，勿当作本次完整复盘'}。`);
 lines.push('','所有率的变化使用百分点；计数基线为0时不计算相对增长。未知不填0，不从平均观看秒数推断具体流失时刻，也不把同期增长归因为推荐或某项创作做法。','本报告按已登记数据计算；来源图片未在本轮重新复验，平台同类百分位保留原记录的范围和标注。');return lines.join('\n');
}
