const keys=Object.keys(METRICS) as InsightMetric[];
const interactions:InsightMetric[]=['recommendations','likes','comments','shares','saves','follows'];
const record=(value:unknown):Record<string,unknown>=>value&&typeof value==='object'&&!Array.isArray(value)?value as Record<string,unknown>:{};
const stamp=(value:unknown)=>typeof value==='string'&&Number.isFinite(Date.parse(value))?new Date(value).toISOString():null;
const numeric=(value:unknown)=>typeof value==='number'&&Number.isFinite(value)?value:null;
const metricRecord=<T,>(fn:(key:InsightMetric)=>T)=>Object.fromEntries(keys.map(key=>[key,fn(key)])) as Record<InsightMetric,T>;
function parsedMetrics(value:unknown):Metrics{let raw=record(value);if(typeof value==='string')try{raw=record(JSON.parse(value));}catch{}return metricRecord(key=>{const n=numeric(raw[key]);return n!==null&&n>=0&&(!key.endsWith('rate')||n<=100)?n:null;});}
function array(value:unknown):unknown[]{if(Array.isArray(value))return value;if(typeof value==='string')try{const x=JSON.parse(value);if(Array.isArray(x))return x;}catch{}return [];}
function canonical(value:unknown):string{if(Array.isArray(value))return '['+value.map(canonical).join(',')+']';if(value&&typeof value==='object')return '{'+Object.keys(value).filter(k=>(value as Record<string,unknown>)[k]!==undefined).sort().map(k=>JSON.stringify(k)+':'+canonical((value as Record<string,unknown>)[k])).join(',')+'}';return JSON.stringify(value)??'null';}
function signature(value:unknown){let h=BigInt('14695981039346656037');const prime=BigInt('1099511628211');for(const byte of new TextEncoder().encode(canonical(value)))h=BigInt.asUintN(64,(h^BigInt(byte))*prime);return 'fnv1a64:'+h.toString(16).padStart(16,'0');}
function median(values:number[]){const sorted=[...values].sort((a,b)=>a-b),mid=Math.floor(sorted.length/2);return sorted.length?sorted.length%2?sorted[mid]:(sorted[mid-1]+sorted[mid])/2:null;}
const format=(value:number|null)=>value===null?'未采集':String(Math.round(value*100)/100);
function humanTime(value:string|null,withYear=false){if(!value)return '未记录';const parts=Object.fromEntries(new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',year:'numeric',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date(value)).map(p=>[p.type,p.value]));return `${withYear?parts.year+'年':''}${parts.month}月${parts.day}日${parts.hour}:${parts.minute}`;}
function precision(video:Row):InsightVideo['publication_precision']{const published=stamp(video.published_at);return !published?'unknown':nativePublicationInterval(video.publication_source)?nativePublicationInterval(video.publication_source,published)?'observed_interval':'unknown':publicationDetails(video.publication_source)?.precision==='approximate'?'approximate':'source-described';}
function issue(code:string,message:string,video_ids:string[],sample_ids:string[]=[],severity:InsightIssue['severity']='warning'):InsightIssue{return {id:code+':'+video_ids.join(':')+':'+sample_ids.join(':'),code,severity,message,video_ids,sample_ids};}
function finding(kind:InsightFinding['kind'],suffix:string,title:string,text:string,video_ids:string[],points:InsightPoint[],basis:InsightFinding['basis'],metrics:InsightMetric[]=[]):InsightFinding{return {id:kind+':'+video_ids.join(':')+':'+suffix,kind,title,text,video_ids,sample_ids:points.map(p=>p.sample_id),evidence:points.flatMap(p=>metrics.flatMap(metric=>{const percentile=basis==='platform_percentile',peer=p.platform_percentiles.find(v=>v.metric===metric),value=percentile?peer?.value??null:p.metrics[metric];return value===null?[]:[{sample_id:p.sample_id,metric,value,value_kind:percentile?'platform_percentile' as const:'recorded_metric' as const,observed_at:percentile?peer?.observed_at||p.observed_at:p.observed_at,captured_at:p.observed_at,statistical_cutoff_at:percentile?p.diagnostic_at:null}];})),basis};}
const peerKeys:Record<string,InsightMetric>={plays:'plays',completion:'completion_rate',completion_rate:'completion_rate',average_watch:'average_duration',average_duration:'average_duration',three_second:'three_second_rate',three_second_rate:'three_second_rate'};

function point(sample:Row,video:Row,relations:Row[],allVideos:Row[]):InsightPoint{
 const details=record(sampleDetails(sample)),diagnostic=record(details.diagnostic),source=record(details.source),kind=String(sample.sample_kind||''),relation=relations.find(r=>r.id===sample.relation_id),group_key=sampleSeriesKey(sample),family=group_key.startsWith('relation:')?'relation':'single';
 const observed_at=stamp(sample.observed_at),anchor_at=stamp(relation?.published_anchor||video.published_at),anchorVideo=relation?allVideos.find(v=>v.id===relation.new_video_id):video,target_hours=kind==='single_t24'||kind==='relation_baseline'?24:kind==='single_t48'||kind==='relation_followup'?48:null,time_inferred=details.date_inferred===true||/inferred_date|推断|假定/.test(String(details.time_source||''));
 const peers=record(details.peer_percentiles||details.platform_percentiles),labels=record(details.peer_labels),platform_percentiles:InsightPercentile[]=[];
 for(const [key,value] of Object.entries(peers)){const metric=peerKeys[key],n=numeric(value);if(metric&&n!==null&&n>=0&&n<=100&&!platform_percentiles.some(p=>p.metric===metric))platform_percentiles.push({metric,value:n,label:typeof labels[key]==='string'?String(labels[key]):null,source_label:'截图所载平台同类百分位',source_sample_id:sample.id,observed_at:stamp(diagnostic.observed_at)||observed_at});}
 return {sample_id:sample.id,video_id:video.id,sample_kind:kind,relation_id:typeof sample.relation_id==='string'?sample.relation_id:null,family,group_key,observed_at,diagnostic_at:stamp(diagnostic.observed_at),diagnostic_plays:numeric(diagnostic.plays),metrics:parsedMetrics(sample.metrics),anchor_at,actual_hours:anchor_at&&observed_at?(Date.parse(observed_at)-Date.parse(anchor_at))/3600000:null,target_hours,window_comparable:!!anchor_at&&!!observed_at&&target_hours!==null&&!time_inferred&&!!anchorVideo&&precision(anchorVideo)==='source-described'&&samplingWindow(anchor_at,observed_at,target_hours).comparable,time_inferred,source:typeof source.library_file_id==='string'&&typeof source.sha256==='string'?{library_file_id:source.library_file_id,sha256:source.sha256,file_name:String(source.file_name||'原始截图')}:null,evidence_ids:array(sample.evidence_ids).filter((v):v is string=>typeof v==='string'),platform_percentiles,platform_advice:typeof details.platform_advice==='string'?details.platform_advice:null,note:String(details.text||'')};
}
function change(before:InsightPoint,after:InsightPoint,points:InsightPoint[]):InsightChange{
 const interval_hours=before.observed_at&&after.observed_at?(Date.parse(after.observed_at)-Date.parse(before.observed_at))/3600000:null,reasons:string[]=[];
 if(before.group_key!==after.group_key||before.video_id!==after.video_id||before.group_key.startsWith('unclassified:'))reasons.push('different-or-unknown-sampling-group');
 if(interval_hours===null||interval_hours<=0)reasons.push('missing-or-non-increasing-time');
 if(points.filter(p=>p.observed_at===before.observed_at).length>1||points.filter(p=>p.observed_at===after.observed_at).length>1)reasons.push('ambiguous-same-time-samples');
 const delta_eligible=reasons.length===0;
 return {id:before.sample_id+'->'+after.sample_id,video_id:after.video_id,group_key:after.group_key,family:after.family,relation_id:after.relation_id,baseline:before,followup:after,interval_hours,delta_eligible,reasons,metrics:metricRecord(key=>{const a=before.metrics[key],b=after.metrics[key],unit=key.endsWith('rate')?'percentage_points':key==='average_duration'?'seconds':'count',delta=delta_eligible&&a!==null&&b!==null?b-a:null;return {before:a,after:b,delta,relative_pct:unit==='count'&&delta!==null&&a!==null&&a>0?delta/a*100:null,unit,counter_decreased:unit==='count'&&delta!==null&&delta<0};}),interpretation:'同一用途、同一推荐关系的累计面板时间变化；按实际间隔描述，不能归因于改稿、推荐或某项创作技巧。'};
}

export function buildDataInsights(input:DataInsightsInput,{now=new Date().toISOString()}:{now?:string}={}):DataInsights{
 const logical=logicalData(input.videos,input.samples,input.relations),effective=effectiveSamples(logical.canonical_samples),allChanges:InsightChange[]=[],quality:InsightIssue[]=[];
 const videos:InsightVideo[]=logical.current_videos.map(video=>{
   const points=effective.filter(s=>s.video_id===video.id).map(s=>point(s,video,logical.current_relations,logical.current_videos)).sort((a,b)=>(a.observed_at||'').localeCompare(b.observed_at||'')||a.sample_id.localeCompare(b.sample_id)),observed=points.filter(p=>p.observed_at),latest_panel=observed.at(-1)||null,latest_single=observed.filter(p=>p.family==='single'&&!p.group_key.startsWith('unclassified:')).at(-1)||null;
   const groups=new Map<string,InsightPoint[]>();for(const p of points)groups.set(p.group_key,[...(groups.get(p.group_key)||[]),p]);
   const series:InsightSeries[]=[...groups].map(([key,rows])=>{const known=rows.filter(p=>p.observed_at),pairs=known.slice(1).map((p,i)=>change(known[i],p,known));allChanges.push(...pairs);return {key,family:rows[0].family,relation_id:rows[0].relation_id,label:key==='single'?'本片发布后采样':key.startsWith('relation:')?'推荐关系观察 · '+rows[0].relation_id:'用途待确认',anchor_at:rows[0].anchor_at,points:rows,latest_pair:pairs.at(-1)||null};});
   const last_known_metrics=metricRecord(key=>{const p=[...observed].reverse().find(p=>p.metrics[key]!==null);return p?{value:p.metrics[key]!,sample_id:p.sample_id,observed_at:p.observed_at,sample_kind:p.sample_kind}:null;}),issues:InsightIssue[]=[],positives:InsightFinding[]=[],problems:InsightFinding[]=[],next_steps:InsightFinding[]=[];
   const ids=[video.id],duration=numeric(video.duration),pub=precision(video);
   if(!points.length)issues.push(issue('no-samples','尚无效果采样，不能判断播放、互动或留存表现。',ids));
   if(points.some(p=>!p.observed_at))issues.push(issue('missing-observation-time','部分采样缺少有效截图时间，保留记录但不能画时间趋势。',ids,points.filter(p=>!p.observed_at).map(p=>p.sample_id)));
   if(duration===null||duration<=0)issues.push(issue('missing-duration','片长未登记，不能由平均观看秒数推算观看占比或具体流失位置。',ids));
   if(pub==='approximate')issues.push(issue('approximate-publication-time','发布时间为本人约时自报，仅作排序锚点，不进入严格T+24比较。',ids));
   if(pub==='observed_interval')issues.push(issue('observed-interval-publication-time','手机发布只确认观测区间，平台精确发布时间未知；区间上界为保守采集锚点，不进入严格T+24比较。',ids));
   if(pub==='unknown')issues.push(issue('missing-publication-time','发布时间未知，不能计算本片发布后的标准采样窗口。',ids));
   if(points.some(p=>p.time_inferred))issues.push(issue('inferred-observation-date','采样日期或时区含推断，显示实际记录边界，不冒充精确标准采样。',ids,points.filter(p=>p.time_inferred).map(p=>p.sample_id)));
   if(points.some(p=>p.target_hours!==null&&!p.window_comparable))issues.push(issue('non-comparable-window','部分标记T+24/T+48的记录不满足准确、准时窗口；只描述实际时点。',ids,points.filter(p=>p.target_hours!==null&&!p.window_comparable).map(p=>p.sample_id)));
   if(latest_panel&&interactions.every(k=>latest_panel.metrics[k]===null))issues.push(issue('latest-interactions-missing','最新截图未采集互动指标；未知不等于零，较早互动记录单独保留来源。',ids,[latest_panel.sample_id]));
   if(points.some(p=>!p.source&&!p.evidence_ids.length))issues.push(issue('source-evidence-missing','部分采样未关联站内原图或Library身份，需补齐来源供复核。',ids,points.filter(p=>!p.source&&!p.evidence_ids.length).map(p=>p.sample_id)));
   for(const p of points)if(p.diagnostic_at&&p.observed_at&&p.diagnostic_at!==p.observed_at)issues.push(issue('diagnostic-cutoff-differs','面板截图时间与平台诊断截止不同；播放面板和诊断播放分别保留，不互换。',ids,[p.sample_id],'info'));
   for(const s of series)if(s.latest_pair&&!s.latest_pair.delta_eligible)issues.push(issue('invalid-change-pair','相邻采样时点不明确或重复，本组不计算涨幅。',ids,[s.latest_pair.baseline.sample_id,s.latest_pair.followup.sample_id]));
   for(const c of allChanges.filter(c=>c.video_id===video.id))if(keys.some(k=>c.metrics[k].counter_decreased)){const declined=keys.filter(k=>c.metrics[k].counter_decreased);issues.push(issue('cumulative-counter-decreased','累计计数出现下降；可能涉及平台修订或采样口径变化，保留原值并先核对。',ids,[c.baseline.sample_id,c.followup.sample_id]));problems.push(finding('problem','counter-decreased-'+c.id,'累计面板需要核对',declined.map(k=>`${METRICS[k]} 从 ${format(c.metrics[k].before)} 到 ${format(c.metrics[k].after)}`).join('；')+'。先核查平台修订和采样口径，不把下降归因于推荐或创作调整。',ids,[c.baseline,c.followup],'recorded_metrics',declined));}
   if(latest_panel){
     const high=latest_panel.platform_percentiles.filter(p=>p.label==='高'||p.label==='较高'||p.label==='高于同类'),low=latest_panel.platform_percentiles.filter(p=>p.label==='低'||p.label==='较低'||p.label==='低于同类');
     if(high.length)positives.push(finding('positive','platform-high','同类比较中的相对亮点',high.map(p=>`${METRICS[p.metric]}：截图所载平台同类百分位 ${format(p.value)}，原记录标注“${p.label}”`).join('；')+'。这是该次诊断记录的相对位置，不是本站评分，也未证明某种创作方式导致它。',ids,[latest_panel],'platform_percentile',high.map(p=>p.metric)));
     if(low.length)problems.push(finding('problem','platform-low','同类比较中的待改环节',low.map(p=>`${METRICS[p.metric]}：截图所载平台同类百分位 ${format(p.value)}，原记录标注“${p.label}”`).join('；')+'。先区分触达和观看表现，不从均值推断具体流失秒点。',ids,[latest_panel],'platform_percentile',low.map(p=>p.metric)));
     const paired=series.map(s=>s.latest_pair).filter((p):p is InsightChange=>!!p&&p.delta_eligible&&p.metrics.plays.delta!==null);
     for(const p of paired)if(p.metrics.plays.delta!>0)positives.push(finding('positive','plays-'+p.id,'发布后仍记录到播放变化',`同一${p.family==='single'?'本片采样组':'推荐关系观察组'}在北京时间 ${humanTime(p.baseline.observed_at)} 至 ${humanTime(p.followup.observed_at)}（${format(p.interval_hours)}小时）播放由 ${format(p.metrics.plays.before)} 到 ${format(p.metrics.plays.after)}，累计增加 ${format(p.metrics.plays.delta)}。同期变化不能归因为推荐或调整。`,ids,[p.baseline,p.followup],'recorded_metrics',['plays']));
     const knownInteractions=interactions.filter(k=>last_known_metrics[k]!==null);
     if(knownInteractions.length){const refs=[...new Set(knownInteractions.map(k=>last_known_metrics[k]!.sample_id))].map(id=>observed.find(p=>p.sample_id===id)!);positives.push(finding('positive','recorded-interactions','已记录可核对的互动反馈',knownInteractions.map(k=>`${METRICS[k]} ${format(last_known_metrics[k]!.value)}（北京时间${humanTime(last_known_metrics[k]!.observed_at)}）`).join('；')+'。这些是各自最后一次有记录的时点，不能冒充最新面板仍有这些值。',ids,refs,'recorded_metrics',knownInteractions));}
     if(!high.length&&!paired.length&&!knownInteractions.length&&keys.some(k=>latest_panel.metrics[k]!==null))positives.push(finding('positive','recorded-panel','已有真实表现起点',`在北京时间 ${humanTime(latest_panel.observed_at)} 已记录播放 ${format(latest_panel.metrics.plays)}、3秒留存率 ${format(latest_panel.metrics.three_second_rate)}%、完播率 ${format(latest_panel.metrics.completion_rate)}%，可作为后续核验起点，单次采样不推断趋势。`,ids,[latest_panel],'recorded_metrics',['plays','three_second_rate','completion_rate']));
     const suggested=low.some(p=>p.metric==='three_second_rate')?'下一片可先试更早呈现具体结果或冲突，再按同一观察窗口复采；这是待验证建议。':low.some(p=>p.metric==='completion_rate')?'下一片可试压缩重复铺垫、提前兑现核心结果，并保存留存曲线核验；不能仅凭平均秒数判断流失位置。':low.some(p=>p.metric==='plays')&&high.some(p=>p.metric!=='plays')?'先核对选题包装、标题封面与分发来源，进行触达测试，同时保留已有较好观看表现；低触达不能直接判为内容差，这是待验证方向。':'保留本片已记录的表现作为参照，下一片只改变一个明确内容要素，并在同一窗口复采。';
     next_steps.push(finding('next_step','creative-test','下一次创作验证',suggested,ids,[latest_panel],'next_test',low.map(p=>p.metric)));
   }else next_steps.push(finding('next_step','collect-first','先补第一份发布后效果',`为《${String(video.title||'本片')}》补一张含实际采样时间的后台面板；发布时间已过标准窗口时记录任意真实时点，不回填或伪造T+24。`,ids,[],'coverage'));
   if(issues.some(i=>i.code==='latest-interactions-missing'))next_steps.push(finding('next_step','capture-interactions','补齐互动采样',`下一次截图同时保留赞、评论、分享、收藏、关注及各自统计口径；未显示的字段继续留空。`,ids,latest_panel?[latest_panel]:[],'coverage'));
