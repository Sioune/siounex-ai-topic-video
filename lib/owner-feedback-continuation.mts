import {balanceSqlConjunction} from './sql-conjunction.mts';
// A previously saved owner opinion can authorize exactly one new text revision.
// It is not an approval of that revision or of any media.
const parse=(v:any)=>{try{return typeof v==='string'?JSON.parse(v):v}catch{return null}};
function validAiContinuation(job:any,p:any){
 if(!p?.ai_review_id)return true;const a=(job.reviews||[]).find((x:any)=>x.id===p.anchor_grant_id&&x.decision==='owner_feedback_continuation_v1'&&x.reviewer==='site-feedback-continuation'),prior=parse(a?.note),r=(job.reviews||[]).find((x:any)=>x.id===p.ai_review_id&&x.decision==='revise'&&x.reviewer==='codex-cli'),v=parse(r?.note),b=v?.receipt?.review_binding;
 return !!prior&&!prior.ai_review_id&&prior.schema==='owner-feedback-continuation-v1'&&prior.job_id===job.id&&prior.owner_id===p.owner_id&&prior.feedback_id===p.feedback_id&&prior.feedback_note===p.feedback_note&&prior.target_revision===p.source_revision&&prior.reworks+1===p.reworks&&r?.revision===p.source_revision&&r.content_hash===p.source_hash&&v?.actor==='codex-cli'&&v.decision==='revise'&&v.reason===p.ai_review_reason&&b?.job_id===job.id&&b.revision===p.source_revision&&b.mode_epoch===p.mode_epoch&&b.contract_hash===p.contract_hash&&b.artifact_hash===p.source_hash&&v.receipt?.exit_code===0&&v.receipt?.cli_process?.error_code==='CLI_COMPLETED'&&v.receipt?.cli_process?.result_unknown===false;
}
export function ownerFeedbackContinuation(job:any){
 for(const g of job?.reviews||[]){if(g.decision!=='owner_feedback_continuation_v1'||g.reviewer!=='site-feedback-continuation')continue;const p=parse(g.note),r=job.reviews.find((x:any)=>x.id===p?.feedback_id&&x.decision==='script_feedback'),v=parse(r?.note),d=job.drafts?.find((x:any)=>x.revision===p?.source_revision);
  if(validAiContinuation(job,p)&&p?.schema==='owner-feedback-continuation-v1'&&p.job_id===job.id&&p.owner_id===r?.reviewer&&(!job.owner_id||job.owner_id===p.owner_id)&&v?.schema==='siounex-script-feedback-v1'&&v.note===p.feedback_note&&v.revision===r.revision&&v.script_hash===r.content_hash&&v.rework_started===false&&p.mode_epoch===job.mode_epoch&&p.contract_hash===job.contract_hash&&p.target_revision===p.source_revision+1&&[p.source_revision,p.target_revision].includes(job.revision)&&p.source_hash===d?.content_hash&&job.reworks===p.reworks&&Number.isSafeInteger(p.max_ai_calls)&&Number.isSafeInteger(p.max_attempts)&&p.quality_approval===false&&p.publication_authorized===false)return {...p,queue_id:g.id};
 }
