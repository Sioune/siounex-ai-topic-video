export function continuationSql(alias='j'){
 if(!/^[A-Za-z_][A-Za-z0-9_]*$/.test(alias))throw Error('invalid alias');const q="CASE WHEN json_valid(g.note) THEN g.note ELSE '{}' END",f="CASE WHEN json_valid(op.note) THEN op.note ELSE '{}' END",v=(s:string)=>`json_extract(${q},'$.${s}')`;
 const ai=balanceSqlConjunction([`ar.id=${v('ai_review_id')}`,`ar.job_id=${alias}.id`,"ar.decision='revise'","ar.reviewer='codex-cli'",`ar.revision=${v('source_revision')}`,`ar.content_hash=${v('source_hash')}`,'json_valid(ar.note)','json_valid(ag.note)',"json_extract(ar.note,'$.actor')='codex-cli'",`json_extract(ar.note,'$.reason')=${v('ai_review_reason')}`,`json_extract(ar.note,'$.receipt.review_binding.job_id')=${alias}.id`,`json_extract(ar.note,'$.receipt.review_binding.revision')=${v('source_revision')}`,`json_extract(ar.note,'$.receipt.review_binding.mode_epoch')=${v('mode_epoch')}`,`json_extract(ar.note,'$.receipt.review_binding.contract_hash')=${v('contract_hash')}`,`json_extract(ar.note,'$.receipt.review_binding.artifact_hash')=${v('source_hash')}`,"json_extract(ar.note,'$.receipt.exit_code')=0","json_extract(ar.note,'$.receipt.cli_process.error_code')='CLI_COMPLETED'","json_extract(ar.note,'$.receipt.cli_process.result_unknown')=0","json_type(ag.note,'$.ai_review_id') IS NULL",`json_extract(ag.note,'$.feedback_id')=${v('feedback_id')}`,`json_extract(ag.note,'$.feedback_note')=${v('feedback_note')}`,`json_extract(ag.note,'$.target_revision')=${v('source_revision')}`,`json_extract(ag.note,'$.reworks')+1=${v('reworks')}`].join(' AND '));
 const review=`(json_type(${q},'$.ai_review_id') IS NULL OR EXISTS(SELECT 1 FROM production_reviews ar JOIN production_reviews ag ON ag.id=${v('anchor_grant_id')} AND ag.job_id=${alias}.id AND ag.decision='owner_feedback_continuation_v1' AND ag.reviewer='site-feedback-continuation' WHERE ${ai}))`;
 const clauses=balanceSqlConjunction([`g.job_id=${alias}.id`,"g.decision='owner_feedback_continuation_v1'","g.reviewer='site-feedback-continuation'",`${v('schema')}='owner-feedback-continuation-v1'`,`${v('job_id')}=${alias}.id`,`${v('owner_id')}=${alias}.owner_id`,`${v('feedback_note')}=json_extract(${f},'$.note')`,`json_extract(${f},'$.schema')='siounex-script-feedback-v1'`,`json_extract(${f},'$.rework_started')=0`,`json_extract(${f},'$.revision')=op.revision`,`json_extract(${f},'$.script_hash')=op.content_hash`,review,`${v('mode_epoch')}=${alias}.mode_epoch`,`${v('contract_hash')}=${alias}.contract_hash`,`${v('target_revision')}=${v('source_revision')}+1`,`${alias}.revision IN (${v('source_revision')},${v('target_revision')})`,`${v('reworks')}=${alias}.reworks`,`json_extract(${q},'$.quality_approval')=0`,`json_extract(${q},'$.publication_authorized')=0`].join(' AND '));
 return `EXISTS(SELECT 1 FROM production_reviews g JOIN production_reviews op ON op.id=${v('feedback_id')} AND op.job_id=${alias}.id AND op.decision='script_feedback' AND op.reviewer=${alias}.owner_id JOIN production_drafts old ON old.job_id=${alias}.id AND old.revision=${v('source_revision')} AND old.content_hash=${v('source_hash')} WHERE ${clauses})`;
}

export function continuationLimitSql(alias='j',kind:'generation'|'review'='review'){
 const field=kind==='generation'?'max_attempts':'max_ai_calls',fallback=kind==='generation'?6:8;
 return `(CASE WHEN ${continuationSql(alias)} THEN (SELECT MAX(CAST(json_extract(CASE WHEN json_valid(g.note) THEN g.note ELSE '{}' END,'$.${field}') AS INTEGER)) FROM production_reviews g WHERE g.job_id=${alias}.id AND g.decision='owner_feedback_continuation_v1' AND g.reviewer='site-feedback-continuation' AND json_extract(CASE WHEN json_valid(g.note) THEN g.note ELSE '{}' END,'$.reworks')=${alias}.reworks AND json_extract(CASE WHEN json_valid(g.note) THEN g.note ELSE '{}' END,'$.mode_epoch')=${alias}.mode_epoch) ELSE ${fallback} END)`;
}
