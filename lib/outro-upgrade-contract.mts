import raw from '../production/outro-v6-migrations.json' with {type:'json'};
import type {PublishingBinding} from './publishing-contract.mts';
export const OUTRO_V6_UPGRADE_DECISION='outro_v6_technical_upgrade_v1';
export const outroV6Migrations=raw.migrations as any[];
const same=(a:unknown,b:unknown)=>JSON.stringify(a)===JSON.stringify(b);
export function outroV6Migration(jobId:string,sid?:string){return outroV6Migrations.find(m=>m.job_id===jobId&&(!sid||sid===m.source.archive_id||sid===m.file.site_archive_id))||null;}
export function outroV6SourceMatches(m:any,b:any){return !!m&&b.job_id===m.job_id&&b.revision===m.revision&&b.mode_epoch===m.mode_epoch&&b.contract_hash===m.contract_hash&&b.script_hash===m.script_hash&&b.video_milestone_id===m.source.milestone_id&&b.video_artifact_hash===m.source.artifact_hash&&b.video_artifact_version===m.source.artifact_version;}
export function applyV6OutroBinding(b:PublishingBinding):PublishingBinding{const m=outroV6Migration(b.job_id);return outroV6SourceMatches(m,b)&&b.site_archive_id===m.source.archive_id&&b.video_sha256===m.source.sha256?{...b,site_archive_id:m.file.site_archive_id,video_sha256:m.file.sha256,size_bytes:m.file.size_bytes,file_name:m.file.file_name}:b;}
export function v6OutroSourceBinding(b:PublishingBinding):PublishingBinding|null{const m=outroV6Migration(b.job_id);if(!outroV6SourceMatches(m,b)||b.site_archive_id!==m.file.site_archive_id||b.video_sha256!==m.file.sha256||b.size_bytes!==m.file.size_bytes||b.file_name!==m.file.file_name)return null;return{...b,site_archive_id:m.source.archive_id,video_sha256:m.source.sha256,size_bytes:m.source.size_bytes,file_name:m.source.file_name};}
export function currentJobV6Outro(job:any){const m=outroV6Migration(job.id);if(!m||job.revision!==m.revision||job.mode_epoch!==m.mode_epoch||job.contract_hash!==m.contract_hash||job.approved_hash!==m.script_hash)return null;const latest=job.milestones?.filter((v:any)=>v.node==='video'&&v.revision===job.revision&&v.mode_epoch===job.mode_epoch).sort((a:any,b:any)=>b.artifact_version-a.artifact_version)[0];if(latest?.id!==m.source.milestone_id||latest.artifact_hash!==m.source.artifact_hash||latest.artifact_version!==m.source.artifact_version)return null;return job.reviews?.some((r:any)=>{if(r.decision!==OUTRO_V6_UPGRADE_DECISION||r.revision!==m.revision||r.content_hash!==m.file.sha256)return false;try{const n=JSON.parse(r.note);return typeof n.owner_id==='string'&&n.owner_id.length>0&&r.reviewer===n.owner_id&&(!job.owner_id||job.owner_id===n.owner_id)&&n.schema==='owner-outro-v6-technical-upgrade-v1'&&n.source_milestone_id===m.source.milestone_id&&n.source_sha256===m.source.sha256&&n.video_sha256===m.file.sha256&&n.manifest_sha256===m.manifest_sha256&&n.human_review_status_preserved===true}catch{return false}})?m:null;}
