type Row={id:string;created_at?:string;[key:string]:unknown};
export function logicalData(videos:Row[],samples:Row[],relations:Row[]){
 const byId=new Map(videos.map(v=>[v.id,v])),roots=new Map<string,string>();
 function root(id:string,seen=new Set<string>()):string{if(roots.has(id))return roots.get(id)!;if(seen.has(id))throw Error('作品更正链出现循环，不能聚合');seen.add(id);const v=byId.get(id),prior=typeof v?.supersedes_id==='string'?v.supersedes_id:null;const r=prior&&byId.has(prior)?root(prior,seen):id;roots.set(id,r);return r;}
 const latest=new Map<string,Row>(),referenced=new Set(videos.map(v=>v.supersedes_id).filter(Boolean));for(const v of videos){const r=root(v.id),old=latest.get(r);if(!referenced.has(v.id)&&(!old||String(v.created_at||'')>String(old.created_at||'')||v.created_at===old.created_at&&v.id>old.id))latest.set(r,v);}
 const canonical=(id:string)=>latest.get(root(id))?.id||id,groups=new Map<string,Row[]>();for(const r of relations){const key=canonical(String(r.new_video_id))+':'+canonical(String(r.old_video_id));groups.set(key,[...(groups.get(key)||[]),r]);}
 const relationIds=new Map<string,string>(),currentRelations:Row[]=[];for(const rows of groups.values()){const ordered=[...rows].sort((a,b)=>String(b.created_at||'').localeCompare(String(a.created_at||''))||b.id.localeCompare(a.id)),r=ordered[0];for(const old of rows)relationIds.set(old.id,r.id);const fresh=latest.get(root(String(r.new_video_id)));currentRelations.push({...r,new_video_id:canonical(String(r.new_video_id)),old_video_id:canonical(String(r.old_video_id)),published_anchor:fresh?.published_at||r.published_anchor,revision_ids:rows.map(x=>x.id)});}
 const canonicalSamples=samples.map(s=>({...s,video_id:canonical(String(s.video_id)),relation_id:typeof s.relation_id==='string'?relationIds.get(s.relation_id)||s.relation_id:null,original_video_id:s.video_id,original_relation_id:s.relation_id,remapped_from_superseded:s.video_id!==canonical(String(s.video_id))||typeof s.relation_id==='string'&&relationIds.get(s.relation_id)!==s.relation_id}));
 return {current_videos:[...latest.values()],current_relations:currentRelations,canonical_samples:canonicalSamples,logical_counts:{videos:latest.size,video_revisions:videos.length,relations:currentRelations.length,relation_revisions:relations.length,samples:samples.length},revision_roots:Object.fromEntries(roots)};
}
